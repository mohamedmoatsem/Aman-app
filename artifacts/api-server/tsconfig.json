{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../../", 
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false, 
    "rewriteRelativeImportExtensions": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "../../server/**/*.ts",
    "../../auth.ts"
  ]
}
